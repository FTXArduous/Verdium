# Auto detect text files and perform LF normalization
* text=auto

# Build outputs and other large binary artifacts
*.apk filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.pak filter=lfs diff=lfs merge=lfs -text
*.asar filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.keystore filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
apps/admin/dist/win-unpacked/@verdiumadmin.exe filter=lfs diff=lfs merge=lfs -text
release/admin-desktop/@verdiumadmin.exe filter=lfs diff=lfs merge=lfs -text
